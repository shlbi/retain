# Server-only values. Never prefix these with NEXT_PUBLIC_ or VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
# Legacy Supabase projects can use SUPABASE_SERVICE_ROLE_KEY instead.
# Optional: exact canonical deployment origin. Otherwise same-origin uses the request host.
# APP_ORIGIN=https://your-domain.com
